{
  "name": "@kuahr/node",
  "version": "0.3.0",
  "description": "Official Node.js / TypeScript client for Kua company people, payroll drafts, events and webhooks.",
  "license": "MIT",
  "homepage": "https://docs.kuahr.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuahr/kua-sdk.git",
    "directory": "node"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/smoke.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kua",
    "payroll",
    "payments",
    "wallet",
    "api",
    "nigeria",
    "africa"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "bugs": {
    "url": "https://github.com/kuahr/kua-sdk/issues"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
